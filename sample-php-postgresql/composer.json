{
    "name": "hosting2030/sample-php-postgresql",
    "type": "project",
    "description": "Sample Laravel PHP and PostgreSQL deployment testing project.",
    "keywords": ["laravel", "php", "postgresql", "postgres", "deployment-test"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo_pgsql": "*",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
